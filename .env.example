# 生产环境 Node 服务（npm run build 后执行 npm start）；进程环境变量优先于 .env。
# 使用反向代理时监听回环地址；仅在配置好防火墙后才使用 0.0.0.0。
HOST=127.0.0.1
PORT=3000
# 生产环境 HTTPS 源站地址，末尾不带斜杠；TRUST_PROXY=true 时必须填写。
# 填写实际地址，例如 https://lab.example.com；本地开发留空。
PUBLIC_ORIGIN=

# 在 https://github.com/settings/developers 创建 GitHub OAuth 应用。
# 应用主页地址：http://127.0.0.1:5173
# 授权回调地址：http://127.0.0.1:5173/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# 在 Google Cloud 控制台创建 OAuth 凭证。
# 已获授权的重定向地址：http://127.0.0.1:5173/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# MySQL 8.x 连接地址；用户名和密码中的特殊字符需要进行 URL 编码。
DATABASE_URL=mysql://username:password@127.0.0.1:3306/omwai_lab

# 旧版手动报价凭证加密密钥（64 位十六进制字符）；当前功能已不再使用。
# 若需保留历史加密凭证，请安全保存原有密钥。
SITE_CREDENTIAL_ENCRYPTION_KEY=

# 独立 MFA AES-256-GCM 密钥，32 字节 base64；不要复用其他密钥。丢失后无法解密已绑定验证器。
# 生成：node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
MFA_ENCRYPTION_KEY=

# SMTP 邮件服务，用于发送注册及密码重置验证码。
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="OmwAI Lab <no-reply@example.com>"

# 必需的共享 Redis，用于持久化登录会话、邮件验证码、冷却时间及认证限流。
# 生产环境托管 Redis 优先使用支持 TLS 的 rediss://；凭证需要进行 URL 编码。
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_KEY_PREFIX=omwai:auth:
# 仅在可信代理覆盖 X-Forwarded-For 且禁止绕过代理直连时启用。
TRUST_PROXY=false

# 独立随机密钥，用于计算一次性验证码的哈希。
EMAIL_VERIFICATION_SECRET=

# Cloudflare Turnstile 组件密钥；在 Cloudflare 配置允许的生产域名和本地主机名。
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# HTTPS 生产部署时启用，确保认证 Cookie 不通过 HTTP 发送；本地 HTTP 开发保持 false。
COOKIE_SECURE=false

# 独立 OmwAI-Detector API（保持私有，仅允许 Lab 后端访问）。
# 仅回环地址允许 HTTP；远程地址必须使用 HTTPS，且不能包含路径或 API 前缀。
DETECTOR_URL=http://127.0.0.1:8787
# 与 OmwAI-Detector 的 ADMIN_TOKEN 一致；禁止使用 VITE_ 前缀，以免泄露到前端。
DETECTOR_ADMIN_TOKEN=
# 独立随机密钥，至少 32 个字符；更换后，原匿名任务访问凭证失效。
# 生成：node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
DETECTOR_ACCESS_SECRET=

# 通过 Socket.IO 对接现有 Uptime；以下配置仅供服务端使用，禁止使用 VITE_ 前缀。
# UPTIME_ENABLED 和 UPTIME_EGRESS_ENFORCED 同时为 true 才启用；仅填写配置不会创建线上任务。
UPTIME_ENABLED=false
# 仅在 Uptime 服务器已通过网络策略限制探测流量访问私网、回环、链路本地、
# 云元数据及保留地址后设为 true；须覆盖 IPv4、IPv6 和 DNS 重绑定。此开关不会自动配置防火墙。
UPTIME_EGRESS_ENFORCED=false
UPTIME_URL=https://status.omwai.xyz
# Uptime 登录令牌（JWT），不是普通 Uptime API Key，也不是模型 Key。
# 两种认证方式任选其一：填写 TOKEN；或将 TOKEN 留空，填写下面的登录用户名和密码。
# 填写 TOKEN 时优先使用令牌；用户名/密码方式不支持交互式双重验证（MFA）。
UPTIME_TOKEN=
UPTIME_USERNAME=
UPTIME_PASSWORD=
# 允许探测的完整 HTTPS 源站，多个用英文逗号分隔，不含 /v1 等路径。
# 例如 https://api.example.com；还必须与用户已审核站点的源站一致。
# Lab 不配置数据加密密钥。以下密钥仅在 Uptime 服务器的进程环境设置，禁止放入 Lab、源码、数据库或普通备份。
# Uptime 专用变量名：UPTIME_LAB_KEY_ENCRYPTION_KEY；值为独立随机 32 字节的 64 位十六进制字符串。
# 对端未通过加密能力自检时，Lab 拒绝发送任何监控 KEY，不降级明文。
UPTIME_ALLOWED_ORIGINS=
