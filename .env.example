# Production Node server (npm run build && npm start). Existing process env overrides .env.
# Bind loopback behind a reverse proxy; use 0.0.0.0 only with appropriate firewall rules.
HOST=127.0.0.1
PORT=3000
# Production HTTPS origin, no trailing slash; required when TRUST_PROXY=true.
# Set to your real origin, e.g. https://lab.example.com. Leave empty for local development.
PUBLIC_ORIGIN=

# Create a GitHub OAuth App at https://github.com/settings/developers
# Homepage URL: http://127.0.0.1:5173
# Authorization callback URL: http://127.0.0.1:5173/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Create OAuth credentials in Google Cloud Console.
# Authorized redirect URI: http://127.0.0.1:5173/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# MySQL 8.x connection. URL-encode special characters in the username/password.
DATABASE_URL=mysql://username:password@127.0.0.1:3306/omwai_lab

# Independent 32-byte AES-256 key in 64 hexadecimal characters; generate securely and keep outside source control.
# Required before storing authorized site group credentials. Losing it makes stored credentials unusable.
SITE_CREDENTIAL_ENCRYPTION_KEY=

# SMTP server used for registration and password-reset verification emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="OmwAI Lab <no-reply@example.com>"

# Required shared Redis for email codes, cooldowns and authentication rate limits.
# Prefer rediss:// with TLS for managed production Redis; URL-encode credentials.
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_KEY_PREFIX=omwai:auth:
# Enable only behind a trusted proxy that overwrites X-Forwarded-For and blocks direct access.
TRUST_PROXY=false

# Independent random secret used to hash one-time verification codes.
EMAIL_VERIFICATION_SECRET=

# Cloudflare Turnstile widget keys. Configure allowed production and local hostnames in Cloudflare.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Enable in HTTPS production deployments so auth cookies are never sent over HTTP.
COOKIE_SECURE=false
